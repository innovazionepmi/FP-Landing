# SMTP Brevo — Impostazioni → SMTP & API → SMTP key (non la password dell'account)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Indirizzo mittente verificato su Brevo (Impostazioni → Mittenti e IP →
# Mittenti). NON è lo stesso valore di SMTP_USER: quello è solo il login
# di autenticazione (es. "xxxxx@smtp-brevo.com"), non un mittente valido.
SMTP_FROM_EMAIL=

# Destinatario delle notifiche di nuovo lead
NOTIFY_EMAIL_TO=info@emiliozucca.com
